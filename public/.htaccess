# Prevent Directory Listings
Options -Indexes

# Set the default index page
DirectoryIndex index.html

# Custom 404 Page redirection (Next.js export builds 404.html)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTML requests to remove .html extension if they somehow access /digital-marketing/index.html
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html\ HTTP/
  RewriteRule ^(([^/]+/)*)index\.html$ /$1 [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]*)\.html\ HTTP/
  RewriteRule ^(.*)\.html$ /$1 [R=301,L]

  # If a folder exists, mod_dir will handle redirecting to add a trailing slash automatically.
  # If a requested path doesn't exist as a file/directory, let Next.js's 404 handle it.
</IfModule>
